{
  "name": "tiger-i-ausf-h",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Historically researched interactive 3D reconstruction of a Panzerkampfwagen VI Tiger Ausf. H (Henschel, late February 1943)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "playwright test",
    "gauntlet": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "three": "0.185.1",
    "three-mesh-bvh": "0.9.14"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.1",
    "@types/three": "0.185.4",
    "eslint": "^9.37.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
